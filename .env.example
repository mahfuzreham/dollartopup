DB_DSN=mysql:host=localhost;dbname=dollar_topup;charset=utf8mb4
DB_USER=root
DB_PASS=
WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# BSC transaction confirmation checker
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_CONFIRMATIONS=12
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955

# Binance automatic withdrawal (keep real keys only in server .env)
BINANCE_AUTO_WITHDRAW=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_USDT_NETWORK=BSC
BINANCE_WALLET_TYPE=0
BINANCE_RECV_WINDOW=5000

# Web admin queue (use a strong unique password)
ADMIN_WEB_USER=admin
ADMIN_WEB_PASS=CHANGE_THIS_STRONG_PASSWORD
